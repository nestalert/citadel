    - target: {fileID: 8223883991401491175, guid: 314dab8d89a56cc4ea408f5aea01b199, type: 3}
      propertyPath: m_text
      value: "\u039F\u03B9 \u03BD\u03AC\u03BD\u03BF\u03B9 \u03AE\u03C4\u03B1\u03BD
        \u03C3\u03C0\u03AC\u03BD\u03B9\u03B1 \u03B4\u03B9\u03B1\u03BA\u03CC\u03C3\u03BC\u03B7\u03C3\u03B7
        \u03C4\u03BF\u03BD 18\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1. \u039F\u03B9
        \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03C0\u03B9\u03C3\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD
        \u03CC\u03C4\u03B9 \u03AF\u03C3\u03C9\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
        \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B3\u03B5\u03BB\u03C9\u03C4\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2
        \u03C4\u03BF\u03C5 \u03BA\u03AC\u03C3\u03C4\u03C1\u03BF\u03C5, \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03B9
        \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B1\u03C0\u03BF\u03AF\u03BF\u03C5\u03C2
        \u03AE\u03C4\u03B1\u03BD \u03AC\u03C4\u03BF\u03BC\u03B1 \u03BC\u03B5 \u03BD\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC."
      objectReference: {fileID: 0}
