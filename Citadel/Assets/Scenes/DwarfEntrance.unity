        \u03B2\u03C1\u03AF\u03C3\u03BA\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B7\u03BD
        \u03B5\u03AF\u03C3\u03BF\u03B4\u03BF \u03C4\u03C9\u03BD \u03BA\u03AE\u03C0\u03C9\u03BD.
        \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B2\u03B1\u03C3\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
        \u03C3\u03B5 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC
        \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1, \u03B1\u03C0\u03CC \u03CC\u03C3\u03BF
        \u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03BF\u03C5\u03BC\u03B5."
